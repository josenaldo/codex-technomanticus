# Temporary files
.tmp
.tmp/*

# Artefatos de renderização/automação (Playwright, screenshots de diagramas)
.playwright-mcp/
tokens-sample.png
tokens-final.png

# Obsidian plugin secrets (API keys, TLS private keys)
.obsidian/plugins/obsidian-local-rest-api/data.json

# Obsidian local UI state
.obsidian/workspace.json

__pycache__/
*.pyc

# Logs brutos dos crons (os relatórios .md ficam versionados)
00-Meta/health-audits/.cron.log
00-Meta/revisoes/.cron.log

# Lock de runtime do Claude Code (scheduled tasks)
.claude/scheduled_tasks.lock

# Checkpoints de sessão do Claude Code (estado local, recuperação pós-/clear)
.claude/checkpoints/

# Deps do validador de Mermaid (skill verificar-nota) — reinstaláveis via npm install
.agents/skills/*/scripts/node_modules/
.agents/skills/*/scripts/package-lock.json

# Scratch de execução de planos (superpowers SDD)
.superpowers/
